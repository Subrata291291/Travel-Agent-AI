# =========================
# LLM PROVIDERS
# =========================

GROQ_API_KEY=

OPENROUTER_API_KEY=

GOOGLE_API_KEY=

OPENAI_API_KEY=


# =========================
# LLM ROUTING
# =========================

PRIMARY_LLM=groq

FALLBACK_LLM_1=openrouter
FALLBACK_LLM_2=gemini
FALLBACK_LLM_3=openai


# =========================
# DATABASE
# =========================

DATABASE_URL=sqlite:///./travel_agent.db


# =========================
# APPLICATION
# =========================

APP_ENV=development

DEBUG=true

APP_NAME=Travel Agent


# =========================
# VECTOR DATABASE
# =========================

PINECONE_API_KEY=
PINECONE_INDEX_NAME=



# =========================
# LLM MODELS
# =========================
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_MODEL=openrouter/free

GEMINI_MODEL=gemini-2.5-flash

OPENAI_MODEL=gpt-4o-mini

PRIMARY_LLM=groq
FALLBACK_LLM_1=openrouter
FALLBACK_LLM_2=gemini
FALLBACK_LLM_3=openai

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60