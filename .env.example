# =========================
# LLM PROVIDERS
# =========================

GROQ_API_KEY=

OPENROUTER_API_KEY=

GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_DIMENSIONS=768

OPENAI_API_KEY=

# Live flight search (Duffel)
DUFFEL_API_KEY=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

# Amadeus Self-Service hotel search (test environment by default)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Busbud partner access; live search remains disabled until official API docs
# and account-specific integration details are available.
BUSBUD_API_KEY=
BUSBUD_BASE_URL=


# =========================
# LLM ROUTING
# =========================

PRIMARY_LLM=groq

FALLBACK_LLM_1=openrouter
FALLBACK_LLM_2=gemini
FALLBACK_LLM_3=openai


# =========================
# DATABASE
# =========================

DATABASE_URL=sqlite:///./travel_agent.db


# =========================
# APPLICATION
# =========================

APP_ENV=development

DEBUG=true

APP_NAME=Travel Agent
FRONTEND_URL=https://travel-agentai.netlify.app


# =========================
# VECTOR DATABASE
# =========================

PINECONE_API_KEY=
PINECONE_INDEX_NAME=



# =========================
# LLM MODELS
# =========================
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_MODEL=openrouter/free

GEMINI_MODEL=gemini-3.8-flash

OPENAI_MODEL=gpt-4o-mini

PRIMARY_LLM=groq
FALLBACK_LLM_1=openrouter
FALLBACK_LLM_2=gemini
FALLBACK_LLM_3=openai

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
